# ── MAC Worker Node — Configuration ──────────────────────────────────────────
# Copy this file to .env.worker and fill in the values below.
# Run:  docker compose -f docker-compose.worker.yml --env-file .env.worker up -d

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# URL of the MAC host server (IP of the PC running docker-compose.yml)
MAC_MASTER_URL=http://10.10.12.115

# Enrollment token — generate from Admin → Cluster → "New Enrollment Token"
MAC_ENROLL_TOKEN=paste-token-here

# ── MODEL ─────────────────────────────────────────────────────────────────────
# Default: Gemma 3 4B AWQ (~4 GB VRAM, good for 6-8 GB GPU cards)
# Change to any vLLM-compatible model. See docker-compose.worker.yml for options.
VLLM_MODEL=mlabonne/gemma-3-4b-it-AWQ
VLLM_SERVED_NAME=gemma-3-4b
VLLM_GPU_MEM=0.85
VLLM_MAX_LEN=8192
VLLM_DTYPE=auto
VLLM_PORT=8001

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Display name for this worker node (shown in admin cluster panel)
MAC_WORKER_NAME=worker-lab-1

# Worker's LAN IP (auto-detected if left blank)
MAC_WORKER_IP=

# GPU info (cosmetic — shown in admin panel)
MAC_GPU_NAME=RTX 3060
MAC_GPU_VRAM_MB=6144

# HuggingFace token (needed for gated models like Gemma, Llama)
HF_TOKEN=

# Set to 1 after first download to run offline
TRANSFORMERS_OFFLINE=0
