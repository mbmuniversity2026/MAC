# MAC Worker Node — Environment Config
# Copy this file to .env.worker and fill in the values
# Then run: docker compose -f docker-compose.worker.yml --env-file .env.worker up -d

# ── Required: Host PC connection ────────────────────────────────────────────
MAC_MASTER_URL=https://10.10.12.115
MAC_ENROLL_TOKEN=PASTE_TOKEN_FROM_HOST_HERE

# ── Required: This PC identity ───────────────────────────────────────────────
MAC_WORKER_NAME=PC2-Mistral
MAC_WORKER_IP=                          # leave blank = auto-detect

# ── Model (choose one based on your GPU VRAM) ────────────────────────────────
# 6-8 GB VRAM  → AWQ 4-bit (recommended)
VLLM_MODEL=solidrust/Mistral-7B-Instruct-v0.3-AWQ
VLLM_GPU_MEM=0.85
VLLM_MAX_LEN=8192
VLLM_DTYPE=auto
VLLM_SERVED_NAME=solidrust/Mistral-7B-Instruct-v0.3-AWQ

# 8+ GB VRAM → full fp16
# VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# VLLM_GPU_MEM=0.88
# VLLM_DTYPE=float16

# Other models:
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ        # General chat
# VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ  # Code
# VLLM_MODEL=Qwen/Qwen2-VL-7B-Instruct           # Vision (8+ GB)

# ── Optional: HuggingFace token (only needed for gated models) ───────────────
HF_TOKEN=

# ── Optional: GPU info (auto-detected if blank) ─────────────────────────────
MAC_GPU_NAME=
MAC_GPU_VRAM_MB=

# ── Worker image (pre-built, no compilation needed) ─────────────────────────
MAC_WORKER_IMAGE=ghcr.io/mbmuniversity2026/mac-worker:latest
