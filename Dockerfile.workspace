FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Kolkata
ENV HOME=/home/user
ENV PATH="/home/user/.local/bin:/usr/local/go/bin:/home/user/.cargo/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git sudo nano vim less \
    build-essential gcc g++ make cmake gfortran \
    python3 python3-pip python3-venv python3-dev \
    default-jdk \
    nodejs npm \
    golang-go \
    cargo rustc \
    zip unzip tar gzip tree htop \
    libopenblas-dev liblapack-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Core API + data science packages
RUN pip3 install --no-cache-dir \
    openai httpx requests aiohttp websockets \
    numpy pandas matplotlib seaborn plotly \
    scipy statsmodels \
    scikit-learn xgboost lightgbm catboost \
    jupyter ipython notebook jupyterlab \
    black pylint flake8 isort mypy \
    flask fastapi uvicorn gunicorn \
    sqlalchemy psycopg2-binary \
    pillow opencv-python-headless \
    pydantic rich tabulate tqdm \
    python-dotenv

# ML / Deep Learning (CPU-only torch — GPU available if host has CUDA)
RUN pip3 install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# NLP + Transformers ecosystem
RUN pip3 install --no-cache-dir \
    transformers datasets accelerate peft \
    sentence-transformers \
    tokenizers safetensors einops \
    nltk

# Utility ML libs
RUN pip3 install --no-cache-dir \
    sympy \
    networkx \
    numba \
    joblib \
    imbalanced-learn \
    shap \
    optuna \
    mlflow

# Create non-root user with sudo
RUN useradd -m -s /bin/bash user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /workspace && \
    chown user:user /workspace

# Nice shell, aliases, env
RUN echo 'export PS1="\[\033[01;32m\]mbmbook\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "' >> /home/user/.bashrc && \
    echo 'alias ll="ls -la --color=auto"' >> /home/user/.bashrc && \
    echo 'alias python=python3' >> /home/user/.bashrc && \
    echo 'alias pip=pip3' >> /home/user/.bashrc && \
    echo 'export PYTHONPATH=/workspace' >> /home/user/.bashrc && \
    echo 'export JUPYTER_RUNTIME_DIR=/tmp/jupyter_runtime' >> /home/user/.bashrc

USER user
WORKDIR /workspace

CMD ["/bin/bash", "--login"]
