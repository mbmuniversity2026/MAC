# MAC MOST — Cluster Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Run start-most-host.bat on the HOST PC (PC1)
#      → It auto-generates cluster.env with real values
#   2. Copy cluster.env (not this file) to PC2 and PC3 MAC repo folders
#   3. Run start-most-worker-pc2.bat on PC2
#   4. Run start-most-worker-pc3.bat on PC3
#
# Workers read cluster.env automatically — no manual input needed.
# ─────────────────────────────────────────────────────────────────────────────

# HOST PC (PC1) LAN IP address — filled automatically by start-most-host.bat
HOST_IP=
HOST_URL=
HOST_HTTPS_URL=

# Cluster enrollment token — filled automatically by start-most-host.bat
# Workers use this to join the cluster without admin interaction
ENROLL_TOKEN=

# Admin credentials — used to auto-generate/refresh enrollment tokens
# Update if you changed the admin password via Admin Panel > Users
ADMIN_EMAIL=abhisek.cse@mbm.ac.in
ADMIN_PASS=Admin@1234
